\addvspace {10pt}
\contentsline {figure}{\numberline {1.1}{\ignorespaces LTE-DL throughput distribution before anomaly detection. The long upper tail motivates robust lower-tail statistics and conditional expected-throughput references rather than one global Gaussian threshold.}}{3}{figure.caption.3}%
\contentsline {figure}{\numberline {1.2}{\ignorespaces Statistical anomaly-score distribution for flagged samples only. The score spans multiple severity bands rather than behaving as a binary flag, allowing the statistical layer to rank detected samples by the strength of the observed degradation.}}{8}{figure.caption.9}%
\contentsline {figure}{\numberline {1.3}{\ignorespaces Representative statistical-only anomaly context window. The highlighted interval shows the selected anomaly, while the surrounding panels preserve expected-throughput references, radio-signal evidence, and link-adaptation/decoding KPIs for interpretation.}}{9}{figure.caption.10}%
\contentsline {figure}{\numberline {1.4}{\ignorespaces Distribution of final fused row-level priority. The row score represents the seriousness and evidence strength of an exact one-second observation before temporal aggregation.}}{13}{figure.caption.12}%
\contentsline {figure}{\numberline {1.5}{\ignorespaces Priority distribution of strict final episodes. Episode scoring broadens the question from ``how bad was this second?'' to ``how severe, persistent, and well-supported was the complete anomaly period?''}}{15}{figure.caption.13}%
\contentsline {figure}{\numberline {1.6}{\ignorespaces Operational RCA incident-priority distribution. The incident score is intentionally more conservative than the peak row score because it represents the complete engineer-facing problem after persistence, recurrence, and evidence consistency are considered.}}{16}{figure.caption.14}%
\contentsline {figure}{\numberline {1.7}{\ignorespaces Final anomaly-detection and RCA-handoff funnel for the most recent run. Statistical and ML paths are not additive counts at every intermediate stage; they converge at row-level fusion before episode and incident aggregation.}}{16}{figure.caption.15}%
\contentsline {figure}{\numberline {1.8}{\ignorespaces Representative high-priority fused episode. The shaded region marks the selected anomaly period; the upper panel emphasizes opportunity references and the lower panel shows central/temporal predictive context.}}{17}{figure.caption.16}%
\contentsline {figure}{\numberline {1.9}{\ignorespaces Worst-performing LTE serving cells ranked by the multi-KPI percentile badness score. Ranking reliability must be interpreted together with the score.}}{19}{figure.caption.17}%
\addvspace {10pt}
\contentsline {figure}{\numberline {2.1}{\ignorespaces Incident-level RCA dataset overview showing final population metadata, severity distribution, dominant RCA classifications, and median KPI context.}}{23}{figure.caption.19}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Core radio KPI distributions across the incident dataset: RSRP, RSRQ, SINR, CQI, MCS, and BLER.}}{25}{figure.caption.22}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces Engineering RCA cause taxonomy for LTE throughput degradation and the supporting KPI/evidence branches.}}{26}{figure.caption.23}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces Three-JSON RCA knowledge-base architecture: \texttt {causes.json} defines what is evaluated and in which order, \texttt {kpi\_rules.json} defines how evidence is tested, and \texttt {solutions.json} defines what action follows a confirmed cause.}}{28}{figure.caption.24}%
\contentsline {figure}{\numberline {2.5}{\ignorespaces Severity composition per RCA classification in the deterministic results.}}{32}{figure.caption.27}%
\addvspace {10pt}
\contentsline {figure}{\numberline {3.1}{\ignorespaces End-to-end planning pipeline. Geometry (Stage~3) is shared between the assignment engine (Stage~5) and the independent validator (Stage~6), guaranteeing both agree on what ``facing'' means.}}{40}{figure.caption.33}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Cosine alignment model: alignment vs. angular offset from boresight. Key points: $0^\circ \rightarrow 1.0$, $60^\circ \rightarrow 0.5$, $90^\circ \rightarrow 0.0$.}}{43}{figure.caption.36}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Interference potential vs. distance for a fully-facing pair (both alignments $=1.0$) and a one-sided pair (only one antenna facing). Tier-1 (7\,km) and Tier-2 (14\,km) boundaries are marked for reference.}}{44}{figure.caption.37}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces Ring adjacency for a 4-sector site at $0^\circ /90^\circ /180^\circ /270^\circ $. Ring pairs (solid) must differ under the hard rule; the two non-adjacent diagonal pairs (dashed) may reuse a Mod3/Mod4 value if the pigeonhole principle forces it.}}{45}{figure.caption.41}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces Measured site-size distribution, full dataset. $431+2=433$ sites fall under the 4--5-sector ring-adjacent-only rule.}}{45}{figure.caption.43}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces Measured KPI results, full dataset, single full-reset run. Green bars are hard rules (all zero); amber bars are soft, structurally-expected counts.}}{53}{figure.caption.52}%
\contentsline {figure}{\numberline {3.7}{\ignorespaces \texttt {bulk\_plan()} wall-clock time per region, measured on the full dataset.}}{54}{figure.caption.54}%
