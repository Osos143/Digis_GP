        </div>

        {/* Main Content */}
        <div className="relative z-10 max-w-xl">
           <div className="flex items-center gap-3 mb-8">
             <div className="w-12 h-12 bg-gradient-to-tr from-[#2563EB] to-[#06B6D4] rounded-xl flex items-center justify-center shadow-lg">
